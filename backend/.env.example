# Copy this file to ".env" for local use. NEVER commit a real .env file.
# All secrets live here as server-side environment variables only.

# --- Database ---
# Local dev with zero setup: leave DATABASE_URL unset to use a SQLite file.
# Recommended / production: PostgreSQL. Example:
# DATABASE_URL=postgresql+psycopg://aipentest:CHANGE_ME@localhost:5432/aipentest

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Development conveniences ---
# Insert sample/mock data on startup when the database is empty.
SEED_ON_STARTUP=true

# NOTE: real secrets (LLM API keys, etc.) are NOT needed in Milestone 1
# because no real scanning or AI calls happen yet.
